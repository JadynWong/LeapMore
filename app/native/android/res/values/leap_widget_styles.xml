<resources>
  <style name="LeapWidgetLabel">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">#49616a</item>
    <item name="android:textSize">11sp</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:maxLines">1</item>
    <item name="android:ellipsize">end</item>
  </style>
  <style name="LeapWidgetReading" parent="LeapWidgetLabel">
    <item name="android:textColor">#17313b</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">24sp</item>
  </style>
  <style name="LeapWidgetIcon">
    <item name="android:layout_width">15dp</item>
    <item name="android:layout_height">15dp</item>
    <item name="android:importantForAccessibility">no</item>
  </style>
</resources>
