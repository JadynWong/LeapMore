<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_metric"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:layout_marginHorizontal="2dp" android:orientation="vertical" android:paddingHorizontal="5dp" android:paddingVertical="4dp"
    android:background="@drawable/leap_widget_action">
    <TextView android:id="@+id/widget_label" style="@style/LeapWidgetLabel" android:layout_width="match_parent"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/widget_detail" style="@style/LeapWidgetLabel" android:layout_width="match_parent" android:layout_marginTop="2dp"
        android:textSize="12sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
